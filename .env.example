# ── TerenLabs site — переменные окружения ──────────────────────────
# Скопируй в .env.local для разработки. В проде задаются на хостинге.

# next-auth: сгенерировать `openssl rand -base64 32`.
# В ПРОДЕ — СВОЙ секрет, не из dev-окружения.
AUTH_SECRET=

# Канонический URL сайта (для auth-колбэков и sitemap/OG)
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# OAuth-провайдеры (опциональны — без них вход скрыт, сайт работает аноним)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# API бэкенда (чат Ноа + лидерборд Океана). Дефолт — Railway prod.
NEXT_PUBLIC_AI_API=https://terenlabs-production.up.railway.app/chat
